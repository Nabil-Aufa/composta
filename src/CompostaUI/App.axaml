<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Composta.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />

        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #1F000000" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1B5E20" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.light">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1B5E20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8F5E9" />
            <Setter Property="Foreground" Value="#1B5E20" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#EEF2EC" />
            <Setter Property="Foreground" Value="#2F3A2F" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="ListBox#lstBatches ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="ListBox#lstBatches ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F6EF" />
        </Style>
        <Style Selector="ListBox#lstBatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E3F1E0" />
        </Style>
        <Style Selector="ListBox#lstBatches ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D7EBD3" />
        </Style>

        <Style Selector="Button.small">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FFEBEE" />
            <Setter Property="Foreground" Value="#B71C1C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFCDD2" />
            <Setter Property="Foreground" Value="#B71C1C" />
        </Style>

        <Style Selector="Border.dbstatus">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#1B5E20" />
        </Style>
        <Style Selector="Border.dbstatus TextBlock">
            <Setter Property="Foreground" Value="#C8E6C9" />
        </Style>
        <Style Selector="Border.dbstatus.disconnected">
            <Setter Property="Background" Value="#8E1B1B" />
        </Style>
        <Style Selector="Border.dbstatus.disconnected TextBlock">
            <Setter Property="Foreground" Value="#FFCDD2" />
        </Style>

        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style Selector="Border.pill.active">
            <Setter Property="Background" Value="#E3F2FD" />
        </Style>
        <Style Selector="Border.pill.active TextBlock">
            <Setter Property="Foreground" Value="#0D47A1" />
        </Style>
        <Style Selector="Border.pill.curing, Border.pill.medium">
            <Setter Property="Background" Value="#FFF4D6" />
        </Style>
        <Style Selector="Border.pill.curing TextBlock, Border.pill.medium TextBlock">
            <Setter Property="Foreground" Value="#8D5A00" />
        </Style>
        <Style Selector="Border.pill.ready, Border.pill.low">
            <Setter Property="Background" Value="#E8F5E9" />
        </Style>
        <Style Selector="Border.pill.ready TextBlock, Border.pill.low TextBlock">
            <Setter Property="Foreground" Value="#1B5E20" />
        </Style>
        <Style Selector="Border.pill.archived">
            <Setter Property="Background" Value="#ECEFF1" />
        </Style>
        <Style Selector="Border.pill.archived TextBlock">
            <Setter Property="Foreground" Value="#455A64" />
        </Style>
        <Style Selector="Border.pill.high">
            <Setter Property="Background" Value="#FFEBEE" />
        </Style>
        <Style Selector="Border.pill.high TextBlock">
            <Setter Property="Foreground" Value="#B71C1C" />
        </Style>

        <Style Selector="Border.preview">
            <Setter Property="Background" Value="#E8F5E9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.preview.warning">
            <Setter Property="Background" Value="#FFF4D6" />
        </Style>
        <Style Selector="TextBlock.previewTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1B5E20" />
        </Style>
        <Style Selector="Border.preview.warning TextBlock.previewTitle">
            <Setter Property="Foreground" Value="#8D5A00" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="#6B776B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2A1F" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#2F3A2F" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Application.Styles>
</Application>
