<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Composta.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />

        <!-- Kartu putih -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BoxShadow" Value="0 1 4 0 #1F000000" />
        </Style>

        <!-- Tombol utama (hijau) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1B5E20" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Tombol terang (di atas header hijau) -->
        <Style Selector="Button.light">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1B5E20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8F5E9" />
            <Setter Property="Foreground" Value="#1B5E20" />
        </Style>

        <!-- Tombol sekunder -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#EEF2EC" />
            <Setter Property="Foreground" Value="#2F3A2F" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Item pada daftar batch -->
        <Style Selector="ListBox#lstBatches ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="ListBox#lstBatches ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F6EF" />
        </Style>
        <Style Selector="ListBox#lstBatches ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E3F1E0" />
        </Style>
        <Style Selector="ListBox#lstBatches ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D7EBD3" />
        </Style>

        <!-- Tombol kecil & tombol hapus -->
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FFEBEE" />
            <Setter Property="Foreground" Value="#B71C1C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFCDD2" />
            <Setter Property="Foreground" Value="#B71C1C" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="#6B776B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1F2A1F" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#2F3A2F" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Application.Styles>
</Application>
