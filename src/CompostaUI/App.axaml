<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Composta.App"
             RequestedThemeVariant="Light">
    <!--
        Token desain diambil dari Figma "Composta — UI/UX Design",
        halaman 02 · Design system (Foundations v1) dan UI GUIDE.
    -->
    <Application.Resources>
        <FontFamily x:Key="ManropeFont">avares://CompostaUI/Assets/Fonts#Manrope</FontFamily>

        <Color x:Key="CanvasColor">#F7F6EF</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="ForestColor">#244B38</Color>
        <Color x:Key="InkColor">#25372B</Color>
        <Color x:Key="MutedColor">#657063</Color>
        <Color x:Key="SageColor">#E8EDDF</Color>
        <Color x:Key="LineColor">#DDE2D6</Color>
        <Color x:Key="TerraColor">#8B4B32</Color>

        <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="ForestBrush" Color="{StaticResource ForestColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="SageBrush" Color="{StaticResource SageColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="TerraBrush" Color="{StaticResource TerraColor}" />
        <!-- Panel hijau muda (banner, cuaca, grafik, baris terpilih) -->
        <SolidColorBrush x:Key="LeafBrush" Color="#E3EBDA" />
        <SolidColorBrush x:Key="DisabledBrush" Color="#E6E7E2" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#9AA29A" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="#244B38"
                                       AltHigh="White"
                                       BaseHigh="#25372B"
                                       RegionColor="White"
                                       ErrorText="#B3261E" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Tipografi: Manrope untuk navigasi, data, dan tindakan -->
        <Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="{StaticResource ManropeFont}" />
        </Style>
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style Selector="TextBlock.display">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#B3261E" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.completed">
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="TextBlock.overdue">
            <Setter Property="Foreground" Value="#B3261E" />
        </Style>
        <Style Selector="TextBlock.pending">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Panel: radius 16 px, banner: radius 24 px -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector="Border.leaf">
            <Setter Property="Background" Value="{StaticResource LeafBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.banner">
            <Setter Property="Background" Value="{StaticResource LeafBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.topbar">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Background" Value="{StaticResource SageBrush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="Border.avatar TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>

        <!-- Tombol: radius 8 px kontrol, target klik minimal 44 px -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource TerraBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.round">
            <Setter Property="CornerRadius" Value="22" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource ForestBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InkBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{StaticResource SageBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE4D1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- Tombol putih di atas panel hijau tua -->
        <Style Selector="Button.light">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="Button.light:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.light:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SageBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>

        <!-- Tombol teks tanpa latar -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14244B38" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="Button.ghost.onDark">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.ghost.onDark:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost.onDark:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#F4E6DF" />
            <Setter Property="Foreground" Value="{StaticResource TerraBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#ECD3C7" />
            <Setter Property="Foreground" Value="{StaticResource TerraBrush}" />
        </Style>

        <!-- Disabled dipakai saat input belum lengkap -->
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DisabledBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
        </Style>
        <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.onDark:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.onDark:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.light:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.light:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>

        <!-- Toggle Hijau / Cokelat -->
        <Style Selector="RadioButton.segment">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="segmentBorder" CornerRadius="18" Padding="16,0" MinHeight="36"
                            Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Border#segmentBorder">
            <Setter Property="Background" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="RadioButton.segment:focus-visible /template/ Border#segmentBorder">
            <Setter Property="BorderBrush" Value="{StaticResource TerraBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Input -->
        <Style Selector="TextBox, ComboBox, NumericUpDown">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D1C2" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource ForestBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#B3261E" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9D1C2" />
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
            <Setter Property="BorderBrush" Value="{StaticResource ForestBrush}" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>

        <!-- Badge tahap pengomposan (UI GUIDE · Tahap batch) -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Background" Value="{StaticResource SageBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill.ready">
            <Setter Property="Background" Value="#DCE8D2" />
        </Style>
        <Style Selector="Border.pill.ready TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="Border.pill.curing">
            <Setter Property="Background" Value="#F5E6CC" />
        </Style>
        <Style Selector="Border.pill.curing TextBlock">
            <Setter Property="Foreground" Value="#6E4A1C" />
        </Style>
        <Style Selector="Border.pill.active">
            <Setter Property="Background" Value="#E2E9EC" />
        </Style>
        <Style Selector="Border.pill.archived">
            <Setter Property="Background" Value="#ECEDE8" />
        </Style>
        <Style Selector="Border.pill.archived TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Panel pratinjau (Catat Sampah) -->
        <Style Selector="Border.preview">
            <Setter Property="Background" Value="{StaticResource LeafBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.preview.warning">
            <Setter Property="Background" Value="#F3E8DA" />
        </Style>
        <Style Selector="TextBlock.previewTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ForestBrush}" />
        </Style>
        <Style Selector="Border.preview.warning TextBlock.previewTitle">
            <Setter Property="Foreground" Value="{StaticResource TerraBrush}" />
        </Style>

        <!-- Daftar batch berbentuk tabel -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem Border.row">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{StaticResource ForestBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="60" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover Border.row">
            <Setter Property="Background" Value="#FBFBF7" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected Border.row">
            <Setter Property="Background" Value="{StaticResource LeafBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem TextBlock.selectedHint">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected TextBlock.selectedHint">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem TextBlock.pickHint">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected TextBlock.pickHint">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Varian dengan garis tepi (daftar profil) -->
        <Style Selector="ListBox.rows.outlined ListBoxItem Border.row">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.rows.outlined ListBoxItem:selected Border.row">
            <Setter Property="BorderBrush" Value="{StaticResource ForestBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
    </Application.Styles>
</Application>
