<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Composta.ViewModels"
        x:Class="Composta.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Composta - Dashboard"
        Width="980" Height="640"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F1">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2E7D32" Padding="28,18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="🌱 Composta" FontSize="24" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="{Binding Greeting}" FontSize="13" Foreground="#C8E6C9" />
                    <Border Classes="dbstatus" Classes.disconnected="{Binding !IsDatabaseConnected}"
                            Margin="0,8,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding DatabaseStatusText}" FontSize="12" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Classes="light" VerticalAlignment="Center"
                        Content="+ Catat Sampah" Command="{Binding AddWasteCommand}" />
            </Grid>
        </Border>

        <Grid Margin="28,22" RowDefinitions="Auto,*" ColumnDefinitions="*,330">
            <UniformGrid Grid.ColumnSpan="2" Columns="3" Margin="0,0,0,18">
                <Border Classes="card" Margin="0,0,9,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Emisi CO2e dicegah" />
                        <TextBlock Text="{Binding TotalCo2eText}" FontSize="26" FontWeight="Bold" Foreground="#2E7D32" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="9,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Batch berjalan" />
                        <TextBlock Text="{Binding ActiveBatchCountText}" FontSize="26" FontWeight="Bold" Foreground="#1F2A1F" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="9,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption" Text="Total sampah diolah" />
                        <TextBlock Text="{Binding TotalWeightText}" FontSize="26" FontWeight="Bold" Foreground="#1F2A1F" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1" Classes="card" Margin="0,0,18,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="section" Text="Batch Kompos" />
                            <TextBlock Classes="caption" Text="Pilih batch untuk melihat rekomendasi perawatan" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="small primary" Content="+ Batch Baru" Command="{Binding NewBatchCommand}" />
                            <Button Classes="small secondary" Content="Panen" Command="{Binding HarvestCommand}" />
                            <Button Classes="small danger" Content="Hapus" Command="{Binding DeleteBatchCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Classes="caption" IsVisible="{Binding HasNoBatches}"
                               Margin="0,8" Text="Belum ada batch. Klik &quot;+ Batch Baru&quot; untuk memulai." />
                    <ListBox x:Name="lstBatches" Background="Transparent"
                             ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BatchItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="2,6">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#1F2A1F" />
                                    <Border Grid.Column="1" Grid.RowSpan="2" Classes="pill" VerticalAlignment="Top"
                                            Classes.active="{Binding IsActive}" Classes.curing="{Binding IsCuring}"
                                            Classes.ready="{Binding IsReady}" Classes.archived="{Binding IsArchived}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{Binding Detail}" Classes="caption" Margin="0,3,0,0" />
                                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Value="{Binding Progress}"
                                                 Maximum="100" Height="6" MinHeight="6" Margin="0,8,0,0"
                                                 Foreground="#43A047" Background="#E3EBE1" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="18">
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding WeatherLocationText}" Classes="caption" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⛅" FontSize="30" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WeatherTemperatureText}" FontSize="30" FontWeight="Bold" Foreground="#1F2A1F" />
                        </StackPanel>
                        <TextBlock Text="{Binding WeatherConditionText}" FontSize="14" FontWeight="Medium" Foreground="#2F3A2F" />
                        <TextBlock Text="{Binding WeatherDetailText}" Classes="caption" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding RecommendationTitle}" Classes="section" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="pill"
                                    Classes.high="{Binding IsHighPriority}" Classes.medium="{Binding IsMediumPriority}"
                                    Classes.low="{Binding IsLowPriority}">
                                <TextBlock Text="{Binding PriorityText}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding RecommendationText}" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="20" Foreground="#2F3A2F" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
