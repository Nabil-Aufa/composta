<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Composta.ViewModels"
        xmlns:ctl="using:Composta.Views.Controls"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        x:Class="Composta.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Composta - Dashboard"
        Width="1280" Height="820"
        MinWidth="1060" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <!-- Mengikuti frame "Dashboard desktop · Revisi" di halaman UI GUIDE Figma -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28" Spacing="24" MaxWidth="1280">

            <!-- Top bar -->
            <Border Classes="topbar">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <ctl:BrandLogo />
                    <TextBlock Grid.Column="1" Text="Ringkasan" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource ForestBrush}" VerticalAlignment="Center"
                               Margin="40,0,0,0" />
                    <Button Grid.Column="3" Classes="secondary small round" Margin="0,0,10,0"
                            Content="{Binding UserName}" MinWidth="120"
                            ToolTip.Tip="Menu akun"
                            AutomationProperties.Name="Menu akun">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Lihat profil" Command="{Binding ShowProfileCommand}" />
                                <MenuItem Header="Ganti pengguna" Command="{Binding LogoutCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="4" Classes="primary small round" Content="+ Catat Sampah"
                            Command="{Binding AddWasteCommand}" />
                </Grid>
            </Border>

            <!-- Banner ringkasan -->
            <Border Classes="banner" MinHeight="196">
                <Grid ColumnDefinitions="*,400">
                    <StackPanel Margin="32,28" Spacing="18" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Greeting}" Classes="caption" FontSize="13"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Pengolahan kompos" Classes="display" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,*" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel Spacing="2" MinWidth="150">
                                <TextBlock Text="{Binding TotalWeightText}" Classes="stat" />
                                <TextBlock Text="Sampah diolah" Classes="caption" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" MinWidth="170">
                                <TextBlock Text="{Binding TotalCo2eText}" Classes="stat" />
                                <TextBlock Text="Emisi CO₂e dicegah" Classes="caption" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" MinWidth="130">
                                <TextBlock Text="{Binding ActiveBatchCountText}" Classes="stat" />
                                <TextBlock Text="Batch berjalan" Classes="caption" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Ilustrasi pengganti foto banner -->
                    <Border Grid.Column="1" Background="#D3DFC6">
                        <Viewbox Stretch="Uniform" Margin="24,16,24,0" VerticalAlignment="Bottom">
                            <Canvas Width="300" Height="170">
                                <Ellipse Canvas.Left="30" Canvas.Top="20" Width="120" Height="120" Fill="#E3EBDA" Opacity="0.7" />
                                <Ellipse Canvas.Left="190" Canvas.Top="8" Width="70" Height="70" Fill="#E3EBDA" Opacity="0.6" />
                                <Path Fill="#6B4A33" Data="M 0 170 C 40 120 110 112 150 118 C 200 112 260 122 300 170 Z" />
                                <Path Fill="#5A3D2A" Data="M 40 170 C 70 140 120 136 150 140 C 185 136 230 144 260 170 Z" />
                                <Ellipse Canvas.Left="78" Canvas.Top="140" Width="8" Height="6" Fill="#3F2A1D" />
                                <Ellipse Canvas.Left="190" Canvas.Top="148" Width="10" Height="7" Fill="#3F2A1D" />
                                <Ellipse Canvas.Left="120" Canvas.Top="155" Width="7" Height="5" Fill="#3F2A1D" />
                                <Path Stroke="#3E6B2E" StrokeThickness="4" StrokeLineCap="Round" Data="M 150 122 C 150 100 148 80 152 52" />
                                <Path Fill="#5E9B3E" Data="M 151 86 C 140 60 112 52 92 60 C 100 84 126 96 151 86 Z" />
                                <Path Fill="#7DB24F" Data="M 152 70 C 160 42 188 30 212 36 C 206 62 182 78 152 70 Z" />
                                <Path Fill="#8FC25E" Data="M 152 56 C 146 38 150 22 160 12 C 168 26 164 44 152 56 Z" />
                                <Path Stroke="#3E6B2E" StrokeThickness="3" StrokeLineCap="Round" Data="M 232 128 C 232 116 234 106 238 96" />
                                <Path Fill="#7DB24F" Data="M 236 104 C 232 90 220 86 210 90 C 214 102 224 108 236 104 Z" />
                                <Path Fill="#5E9B3E" Data="M 237 100 C 242 86 254 82 264 86 C 260 98 250 104 237 100 Z" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,24,380">
                <!-- Kolom kiri: batch dan jadwal -->
                <StackPanel Spacing="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Batch kompos" Classes="title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="primary small round" Content="+ Batch Baru"
                                Command="{Binding NewBatchCommand}" />
                    </Grid>

                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,90,150,140,140" Margin="16,0">
                            <TextBlock Grid.Column="1" Text="BERAT" Classes="label" />
                            <TextBlock Grid.Column="2" Text="RASIO BROWN/GREEN" Classes="label" />
                            <TextBlock Grid.Column="3" Text="ESTIMASI MATANG" Classes="label" />
                            <TextBlock Grid.Column="4" Text="TAHAP PENGOMPOSAN" Classes="label" />
                        </Grid>

                        <Border Classes="card" IsVisible="{Binding HasNoBatches}" Padding="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Belum ada batch kompos" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Buat batch pertama untuk mulai mencatat sampah organik."
                                           Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="lstBatches" Classes="rows"
                                 ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                                 IsVisible="{Binding !HasNoBatches}"
                                 AutomationProperties.Name="Daftar batch kompos">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:BatchItemViewModel">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,90,150,140,140" Margin="16,10"
                                              VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="caption selectedHint" Text="Terpilih" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding WeightText}" FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding RatioText}" FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding MaturityText}" FontSize="13"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="4" Classes="pill" VerticalAlignment="Center"
                                                    Classes.active="{Binding IsActive}" Classes.curing="{Binding IsCuring}"
                                                    Classes.ready="{Binding IsReady}" Classes.archived="{Binding IsArchived}">
                                                <TextBlock Text="{Binding StatusText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Jadwal perawatan -->
                    <Border Classes="card">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="section" FontSize="19"
                                           Text="{Binding SelectedBatch.Name, StringFormat='Jadwal perawatan · {0}', FallbackValue='Jadwal perawatan', TargetNullValue='Jadwal perawatan'}" />
                                <TextBlock Text="{Binding SelectedBatch.StatusText, FallbackValue=''}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource ForestBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasNoMaintenanceSchedules}">
                                <TextBlock Text="Belum ada jadwal perawatan" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Jadwal akan muncul setelah ada batch kompos yang dipilih."
                                           Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding !HasNoMaintenanceSchedules}">
                                <Grid ColumnDefinitions="*,130,130,96" Margin="0,0,0,8">
                                    <TextBlock Text="Tugas" Classes="caption" />
                                    <TextBlock Grid.Column="1" Text="Jatuh tempo" Classes="caption" />
                                    <TextBlock Grid.Column="2" Text="Status" Classes="caption" />
                                </Grid>
                                <Border Classes="divider" />
                                <ItemsControl ItemsSource="{Binding MaintenanceSchedules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MaintenanceScheduleItemViewModel">
                                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                                    Padding="0,10">
                                                <Grid ColumnDefinitions="*,130,130,96">
                                                    <TextBlock Text="{Binding TaskName}" FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DueDateText}" FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="13"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Classes.completed="{Binding IsCompleted}"
                                                               Classes.overdue="{Binding IsOverdue}"
                                                               Classes.pending="{Binding IsPending}" />
                                                    <Button Grid.Column="3" Content="Selesai" Classes="small secondary"
                                                            IsEnabled="False" HorizontalAlignment="Right"
                                                            ToolTip.Tip="Menunggu integrasi penyimpanan jadwal ke database" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Kolom kanan: rekomendasi, cuaca, grafik -->
                <StackPanel Grid.Column="2" Spacing="16">
                    <Border Background="{StaticResource ForestBrush}" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#CFDDC6" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="RecommendationTitle" />
                                        <Binding Path="PriorityText" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedBatch.StatusText, FallbackValue='Belum ada batch', TargetNullValue='Belum ada batch'}"
                                       FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RecommendationText}" FontSize="13" LineHeight="20"
                                       Foreground="#E4EEDF" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Button Classes="light small round" Content="Panen batch"
                                        Command="{Binding HarvestCommand}" />
                                <Button Classes="ghost onDark small" Content="Hapus batch"
                                        Command="{Binding DeleteBatchCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cuaca -->
                    <Border Classes="leaf">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Text="{Binding Weather.LocationText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource ForestBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Classes="ghost small" Content="Ubah lokasi"
                                        MinHeight="32" Padding="8,0" FontSize="12">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Width="260" Spacing="8" Margin="4">
                                                <TextBlock Text="Lokasi" Classes="field" />
                                                <TextBox Text="{Binding Weather.Location, Mode=TwoWay}"
                                                         Watermark="Contoh: Yogyakarta" MaxLength="100"
                                                         IsEnabled="{Binding !Weather.IsLoading}"
                                                         AutomationProperties.Name="Lokasi cuaca" />
                                                <Button Classes="primary small" Content="Muat cuaca"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding Weather.RefreshCommand}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Grid.Column="2" Classes="ghost small" Content="↻ Muat ulang"
                                        MinHeight="32" Padding="8,0" FontSize="12"
                                        Command="{Binding Weather.RefreshCommand}" />
                            </Grid>
                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding Weather.IsLoading}"
                                         Height="3" MinHeight="3" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Weather.TemperatureText}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource ForestBrush}" />
                                <TextBlock Text="{Binding Weather.ConditionText}" FontSize="14"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Weather.DetailText}" Classes="caption" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Weather.StatusText}" Classes="caption" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource ForestBrush}" IsVisible="{Binding !Weather.IsOffline}" />
                            <TextBlock Text="{Binding Weather.StatusText}" Classes="caption" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TerraBrush}" IsVisible="{Binding Weather.IsOffline}" />
                            <TextBlock Text="{Binding Weather.UpdatedAtText}" Classes="caption" FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Grafik CO2e -->
                    <Border Classes="leaf">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total emisi yang dicegah" Classes="section" />
                            <TextBlock Text="Kumulatif · kg CO₂e" Classes="caption" />
                            <StackPanel Spacing="4" Margin="0,12,0,4" IsVisible="{Binding Co2eChart.HasNoData}">
                                <TextBlock Text="Belum ada data emisi" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Grafik akan muncul setelah ada catatan sampah organik."
                                           Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <lvc:CartesianChart
                                Series="{Binding Co2eChart.Series}"
                                XAxes="{Binding Co2eChart.XAxes}"
                                YAxes="{Binding Co2eChart.YAxes}"
                                Height="190" MinHeight="190" Margin="0,8,0,0"
                                IsVisible="{Binding !Co2eChart.HasNoData}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Status koneksi database -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{StaticResource ForestBrush}"
                         IsVisible="{Binding IsDatabaseConnected}" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" Fill="{StaticResource TerraBrush}"
                         IsVisible="{Binding !IsDatabaseConnected}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DatabaseStatusText}" Classes="caption" FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
