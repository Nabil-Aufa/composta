<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Composta.ViewModels"
        xmlns:models="using:Composta.Models"
        xmlns:ctl="using:Composta.Views.Controls"
        xmlns:conv="using:Composta.Converters"
        x:Class="Composta.Views.LoginWindow"
        x:DataType="vm:LoginViewModel" x:CompileBindings="True"
        Title="Composta - Pilih Pengguna"
        Width="1040" Height="660" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <!-- Mengikuti frame "Pilih pengguna" dan "Buat profil" di halaman UI GUIDE Figma -->
    <DockPanel Margin="32,24,32,28">
        <Border DockPanel.Dock="Top" Classes="topbar">
            <ctl:BrandLogo HorizontalAlignment="Left" />
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Margin="0,24,0,0">
            <Grid ColumnDefinitions="*,32,460" Margin="24,32,0,0">

                <!-- Kolom kiri -->
                <StackPanel Spacing="10">
                    <StackPanel Spacing="10" IsVisible="{Binding IsSelectProfileView}">
                        <TextBlock Text="Pilih pengguna" Classes="display" />
                        <TextBlock Text="Pilih profil untuk membuka batch komposmu." Classes="caption" FontSize="14" />
                        <Border Classes="leaf" Margin="0,24,0,0" Padding="24" MaxWidth="420"
                                HorizontalAlignment="Left" MinWidth="360">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Pengguna terpilih" Classes="caption" />
                                <TextBlock Text="{Binding SelectedUser.Name, FallbackValue='Belum dipilih', TargetNullValue='Belum dipilih'}"
                                           FontSize="24" FontWeight="Bold" Foreground="{StaticResource ForestBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedUser.Email, FallbackValue='Pilih salah satu profil di samping.', TargetNullValue='Pilih salah satu profil di samping.'}"
                                           Classes="caption" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="10" IsVisible="{Binding IsCreateProfileView}">
                        <TextBlock Text="Buat profil" Classes="display" />
                        <TextBlock Text="Gunakan nama dan email untuk profil lokalmu." Classes="caption" FontSize="14" />
                    </StackPanel>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" MinHeight="3"
                                 MaxWidth="420" HorizontalAlignment="Stretch" Margin="0,16,0,0" />
                    <Border Classes="preview" IsVisible="{Binding HasNotice}" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding NoticeMessage}" Classes="previewTitle" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- Kolom kanan: Profil tersimpan -->
                <Border Grid.Column="2" Classes="card" VerticalAlignment="Top"
                        IsVisible="{Binding IsSelectProfileView}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Profil tersimpan" Classes="section" />
                        <TextBlock Text="Belum ada profil. Buat profil baru untuk mulai mencatat sampah."
                                   Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasNoUsers}" />
                        <ListBox Classes="rows outlined" ItemsSource="{Binding Users}"
                                 SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsBusy}" MaxHeight="300"
                                 AutomationProperties.Name="Profil tersimpan">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:User">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,10">
                                            <Border Classes="avatar" Width="36" Height="36" CornerRadius="18">
                                                <TextBlock Text="{Binding Name, Converter={x:Static conv:InitialsConverter.Instance}}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Email}" Classes="caption"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Classes="selectedHint" Text="Terpilih"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource ForestBrush}" />
                                            <TextBlock Grid.Column="2" Classes="pickHint" Text="Pilih"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding ErrorMessage}" Classes="error" IsVisible="{Binding HasError}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                            <Button Classes="secondary small round" Content="Buat profil baru"
                                    Command="{Binding ShowCreateProfileCommand}" />
                            <Button Grid.Column="1" Classes="ghost small" Content="↻ Muat ulang"
                                    HorizontalAlignment="Left" Margin="8,0,0,0"
                                    Command="{Binding LoadUsersCommand}" />
                            <Button Grid.Column="2" Classes="primary small round" Content="Masuk ke profil"
                                    IsDefault="{Binding IsSelectProfileView}"
                                    Command="{Binding LoginCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Kolom kanan: Identitas pengguna -->
                <Border Grid.Column="2" Classes="card" VerticalAlignment="Top"
                        IsVisible="{Binding IsCreateProfileView}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Identitas pengguna" Classes="section" />
                        <StackPanel>
                            <TextBlock Text="Nama lengkap" Classes="field" />
                            <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Nama lengkap"
                                     MaxLength="100" IsEnabled="{Binding !IsBusy}"
                                     AutomationProperties.Name="Nama profil baru" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Email" Classes="field" />
                            <TextBox Text="{Binding Email, Mode=TwoWay}" Watermark="nama@email.com"
                                     MaxLength="255" IsEnabled="{Binding !IsBusy}"
                                     Classes.invalid="{Binding HasError}"
                                     AutomationProperties.Name="Email profil baru" />
                            <TextBlock Text="{Binding ErrorMessage}" Classes="error" Margin="0,6,0,0"
                                       IsVisible="{Binding HasError}" />
                        </StackPanel>
                        <Border Classes="divider" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Classes="secondary small round" Content="Batal"
                                    Command="{Binding ShowSelectProfileCommand}" />
                            <Button Grid.Column="2" Classes="primary small round" Content="Simpan profil"
                                    IsDefault="{Binding IsCreateProfileView}"
                                    Command="{Binding RegisterCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
