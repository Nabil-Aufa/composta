<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Composta.Views.Controls.BrandLogo">
    <!-- Logo Composta dari Figma (tunas di dalam panah daur ulang + tulisan Composta) -->
    <Image Source="avares://CompostaUI/Assets/Images/logo.png" Height="34" Stretch="Uniform"
           HorizontalAlignment="Left" VerticalAlignment="Center"
           RenderOptions.BitmapInterpolationMode="HighQuality"
           AutomationProperties.Name="Composta" />
</UserControl>
