<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Composta.ViewModels"
        xmlns:models="using:Composta.Models"
        xmlns:ctl="using:Composta.Views.Controls"
        x:Class="Composta.Views.AddWasteWindow"
        x:DataType="vm:AddWasteViewModel"
        x:CompileBindings="True"
        Title="Composta - Catat Sampah"
        Width="880" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <!-- Mengikuti frame "Catat Sampah" di halaman UI GUIDE Figma -->
    <StackPanel Margin="32,24,32,24" Spacing="20" MaxWidth="880">
        <StackPanel Spacing="14">
            <ctl:BrandLogo HorizontalAlignment="Left" />
            <TextBlock Text="Catat Sampah" Classes="title" FontSize="28" />
            <Border Classes="divider" />
        </StackPanel>

        <Grid ColumnDefinitions="*,32,300">
            <!-- Form -->
            <StackPanel Spacing="16">
                <StackPanel>
                    <TextBlock Classes="field" Text="Batch tujuan" />
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Pilih batch"
                              ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                              AutomationProperties.Name="Batch tujuan">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BatchItemViewModel">
                                <TextBlock Text="{Binding SelectionLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="field" Text="Nama sampah" />
                    <TextBox Text="{Binding WasteName}" Watermark="Contoh: kulit pisang" MaxLength="100"
                             AutomationProperties.Name="Nama sampah" />
                </StackPanel>

                <Grid ColumnDefinitions="*,16,140">
                    <StackPanel>
                        <TextBlock Classes="field" Text="Kategori" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  AutomationProperties.Name="Kategori sampah">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:WasteCategory">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Classes="field" Text="Berat (kg)" />
                        <NumericUpDown Value="{Binding Weight}" Minimum="0.1" Maximum="100"
                                       Increment="0.5" FormatString="0.##"
                                       AutomationProperties.Name="Berat dalam kilogram" />
                    </StackPanel>
                </Grid>

                <StackPanel IsVisible="{Binding IsCompostable}" Spacing="16">
                    <StackPanel>
                        <TextBlock Classes="field" Text="Jenis bahan" />
                        <Border Background="{StaticResource SageBrush}" CornerRadius="20" Padding="2"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="segment" GroupName="BrownGreen" MinWidth="128"
                                             IsChecked="{Binding IsGreen}" Content="Hijau"
                                             ToolTip.Tip="Bahan basah, kaya nitrogen" />
                                <RadioButton Classes="segment" GroupName="BrownGreen" MinWidth="128"
                                             IsChecked="{Binding IsBrown}" Content="Cokelat"
                                             ToolTip.Tip="Bahan kering, kaya karbon" />
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="caption" Margin="0,6,0,0"
                                   Text="Hijau: basah, kaya nitrogen. Cokelat: kering, kaya karbon." />
                    </StackPanel>
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="field" Text="Kelembapan bahan" />
                            <TextBlock Grid.Column="1" Classes="field" Text="{Binding MoistureText}" />
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Moisture}"
                                AutomationProperties.Name="Kelembapan bahan" />
                    </StackPanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsNonCompostable}">
                    <TextBlock Classes="field" Text="Alasan tidak dapat dikomposkan" />
                    <TextBox Text="{Binding Reason}" Watermark="Contoh: tidak dapat terurai secara alami"
                             MaxLength="255" AutomationProperties.Name="Alasan tidak dapat dikomposkan" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error" />
            </StackPanel>

            <!-- Pratinjau -->
            <Border Grid.Column="2" Classes="preview" Classes.warning="{Binding IsPreviewWarning}"
                    VerticalAlignment="Top" MinHeight="220">
                <StackPanel Spacing="12">
                    <TextBlock Classes="previewTitle"
                               Text="{Binding SelectedBatch.Name, StringFormat='Pratinjau {0}', FallbackValue='Pratinjau', TargetNullValue='Pratinjau'}" />
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                    <Border Classes="divider" Background="#C9D5BE" />
                    <TextBlock Text="{Binding PreviewText}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                               Foreground="{StaticResource InkBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Classes="divider" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="secondary small round" Content="Batal" Command="{Binding CancelCommand}" />
            <Button Classes="primary small round" Content="Simpan catatan" IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
