<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Composta.ViewModels"
        xmlns:conv="using:Composta.Converters"
        x:Class="Composta.Views.ProfileWindow"
        x:DataType="vm:ProfileViewModel" x:CompileBindings="True"
        Title="Composta - Profil Pengguna"
        Width="760" Height="700" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,32,32,28" Spacing="20" MaxWidth="960">
            <TextBlock Text="Profil pengguna" Classes="display" FontSize="30" />

            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="avatar" Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name, Converter={x:Static conv:InitialsConverter.Instance}}"
                                   FontSize="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource ForestBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Email}" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding JoinedAtText}" Classes="caption" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock Text="Dampak pengomposan" FontSize="14" FontWeight="SemiBold" />
                <Border Classes="leaf" Padding="24,20">
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding TotalWeightText}" Classes="stat" FontSize="22" />
                            <TextBlock Text="Total sampah diolah" Classes="caption" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding TotalCo2eText}" Classes="stat" FontSize="22" TextWrapping="Wrap" />
                            <TextBlock Text="Emisi CO₂e dicegah" Classes="caption" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding BatchCountText}" Classes="stat" FontSize="22" />
                            <TextBlock Text="Jumlah batch (termasuk yang sudah dipanen)" Classes="caption"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Koleksi badge" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding BadgeSummaryText}" Classes="caption"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding BadgeErrorText}" Classes="error" TextWrapping="Wrap"
                           IsVisible="{Binding HasBadgeError}" />
                <ItemsControl ItemsSource="{Binding Badges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BadgeItemViewModel">
                            <Border Classes="badge" Classes.locked="{Binding IsLocked}"
                                    Width="216" Margin="0,0,12,12">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Classes="badgeIcon" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Icon}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                                        <TextBlock Text="{Binding Name}" Classes="badgeName" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DescriptionText}" Classes="caption"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusText}" Classes="badgeStatus"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
