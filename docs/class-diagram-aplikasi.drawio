ang CurrentUser (User), WeatherService (OfflineWeatherService / OpenWeatherMapService, dipilih CreateWeatherService dari COMPOSTA_WEATHER_KEY), Advisor (CompostAdvisorService), dan CarbonCalculator (CarbonCalculatorService). Repository memetakan baris tabel menjadi objek di kolom Domain.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1660" y="1654" width="330" height="120" as="geometry"/></mxCell><mxCell id="n264" value="Diagram Kelas Aplikasi CompostaUI (MVVM)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2228" width="600" height="30" as="geometry"/></mxCell><mxCell id="n265" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Abu-abu = View (Avalonia)&lt;br&gt;Kuning = ViewModel&lt;br&gt;Biru = domain class&lt;br&gt;Oranye = interface / library / enum&lt;br&gt;Ungu = implementasi / service&lt;br&gt;&lt;br&gt;segitiga kosong = inheritance&lt;br&gt;garis putus + segitiga = implements&lt;br&gt;garis putus + panah = DataContext" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="1690" y="2228" width="300" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>